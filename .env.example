# Postgres (Neon). Leave unset locally to use the JSON-file fallback in data/local-db.json.
DATABASE_URL=

# Admin login (see /admin). Change both before going live.
ADMIN_PASSWORD=changeme
SESSION_SECRET=change-this-to-a-long-random-string

# DigitalOcean Spaces for uploads. Evidence files are stored PRIVATE (moderators only, via /api/admin/evidence);
# site images (logo) are public. Leave blank locally: files go to data/evidence and public/uploads.
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=sgp1
DO_SPACES_BUCKET=
DO_SPACES_CDN_URL=

# Cloudflare Turnstile captcha on the submit form (leave blank to disable; honeypot + rate limit still apply)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
