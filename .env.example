# Postgres (Neon). Leave unset locally to use the JSON-file fallback in data/local-db.json.
DATABASE_URL=

# Admin login (see /admin). Change both before going live.
ADMIN_PASSWORD=changeme
SESSION_SECRET=change-this-to-a-long-random-string

# Cloudflare Turnstile captcha on the submit form (leave blank to disable; honeypot + rate limit still apply)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Private Vercel Blob store for evidence and site images (local data/files/ folder if unset)
BLOB_READ_WRITE_TOKEN=
